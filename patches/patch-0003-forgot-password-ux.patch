From 0169396f476363352ad729b8b19b3741428fcc93 Mon Sep 17 00:00:00 2001
From: mmw0 <mmw0@users.noreply.github.com>
Date: Thu, 15 Oct 2026 14:32:56 +0000
Subject: [PATCH 3/4] feat(auth): forgot-password UX for the 6-digit OTP flow

Copy updated from 'reset link' to the actual 6-digit code behavior,
anti-enumeration-safe 'if an account exists' phrasing, spam-folder and
retry hints, and a 'Not your email? Start over' reset button.
---
 .../forgot-password-client.tsx                | 25 ++++++++++++++++---
 1 file changed, 21 insertions(+), 4 deletions(-)

diff --git a/src/app/forgot-password/forgot-password-client.tsx b/src/app/forgot-password/forgot-password-client.tsx
index a123018..a0f67d5 100755
--- a/src/app/forgot-password/forgot-password-client.tsx
+++ b/src/app/forgot-password/forgot-password-client.tsx
@@ -102,7 +102,7 @@ export function ForgotPasswordClient() {
       subtitle={
         sent
           ? undefined
-          : "Enter the email tied to your account and we'll send you a secure reset link."
+          : "Enter the email tied to your account and we'll email you a 6-digit reset code."
       }
     >
       {sent ? (
@@ -114,11 +114,15 @@ export function ForgotPasswordClient() {
             Check your inbox
           </h2>
           <p className="mt-2 max-w-xs text-sm text-muted-foreground">
-            We sent a 6-digit reset code to{" "}
+            If an account exists for{" "}
             <span className="font-semibold text-foreground">
               {email || "your email"}
             </span>
-            . It expires in 10 minutes.
+            , a 6-digit reset code is on its way. It expires in 10 minutes.
+          </p>
+          <p className="mt-2 max-w-xs text-xs text-muted-foreground">
+            No email after a few minutes? Check your spam folder, request a new
+            code below, or start over with the correct address.
           </p>
           <form onSubmit={handleSubmit} className="mt-6 w-full space-y-4 text-left">
             <div className="space-y-2">
@@ -194,6 +198,19 @@ export function ForgotPasswordClient() {
               )}
             </Button>
           </form>
+          <Button
+            type="button"
+            variant="link"
+            onClick={() => {
+              setSent(false);
+              setOtpCode("");
+              setNewPassword("");
+              setError(null);
+            }}
+            className="mt-2 h-auto p-0 text-xs text-muted-foreground hover:text-foreground"
+          >
+            Not your email? Start over
+          </Button>
           <Link
             href="/login"
             className="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
@@ -242,7 +259,7 @@ export function ForgotPasswordClient() {
             ) : (
               <>
                 <Mail className="size-4" />
-                Send reset link
+                Send reset code
               </>
             )}
           </Button>
